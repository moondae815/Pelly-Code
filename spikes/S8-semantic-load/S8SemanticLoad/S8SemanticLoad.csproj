<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>S8SemanticLoad</RootNamespace>
    <AssemblyName>s8</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <!-- 전이 버전(9.0.18)은 취약 경고가 나서 제품과 같은 10.0.13으로 고정한다(S6과 같음). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../S6-planning/S6Planning/S6Planning.csproj" />
  </ItemGroup>
  <!--
    배포 형태 3: 단일 파일이지만 Roslyn 보조 프로세스(BuildHost-net472, BuildHost-netcore)는 exe 옆 폴더에 둔다.
    보조 프로세스는 별도 프로세스로 뜨므로 묶음 안에 있으면 찾지 못한다("build host not found").
  -->
  <Target Name="S8KeepBuildHostOutside" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(S8BuildHostOutside)' == 'true'">
    <ItemGroup>
      <_S8BuildHost Include="@(ResolvedFileToPublish)" Condition="$([System.String]::new('%(ResolvedFileToPublish.RelativePath)').StartsWith('BuildHost-'))" />
      <ResolvedFileToPublish Remove="@(_S8BuildHost)" />
      <ResolvedFileToPublish Include="@(_S8BuildHost)" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
