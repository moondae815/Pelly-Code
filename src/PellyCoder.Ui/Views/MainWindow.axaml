<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:PellyCoder.Ui.Views"
        xmlns:s="using:PellyCoder.Ui.Session"
        x:Class="PellyCoder.Ui.Views.MainWindow"
        x:DataType="v:MainWindowModel"
        Title="{Binding Title}"
        Width="900" Height="640" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic"
        Background="White">
  <Window.Resources>
    <FontFamily x:Key="DiffFont">Consolas, D2Coding, Malgun Gothic, monospace</FontFamily>
  </Window.Resources>

  <DockPanel Margin="12">
    <!-- Target, request, commands -->
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock x:Name="TargetText" Text="{Binding TargetLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBox x:Name="RequestBox"
               Text="{Binding Request}"
               IsReadOnly="{Binding !IsRequestEditable}"
               AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="64" MaxHeight="160" />
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="RunButton" Content="실행" IsEnabled="{Binding CanRun}" Click="OnRunClick" />
          <Button x:Name="CancelButton" Content="취소" IsVisible="{Binding CanCancel}" Click="OnCancelClick" />
          <Button x:Name="CloseButton" Content="닫기" IsEnabled="{Binding CanClose}" Click="OnCloseClick" />
        </StackPanel>
        <TextBlock x:Name="CancellingText" Text="되돌리는 중…" IsVisible="{Binding IsCancelling}"
                   VerticalAlignment="Center" FontWeight="SemiBold" />
      </DockPanel>
    </StackPanel>

    <!-- Run summary (verbose only), collapsed -->
    <Expander x:Name="SummaryExpander" DockPanel.Dock="Bottom" Header="실행 요약" IsExpanded="False"
              IsVisible="{Binding HasRunSummary}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
      <ScrollViewer MaxHeight="200">
        <SelectableTextBlock Text="{Binding RunSummaryText}" FontFamily="{StaticResource DiffFont}" />
      </ScrollViewer>
    </Expander>

    <!-- Question area -->
    <StackPanel x:Name="QuestionPanel" DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
      <TextBlock x:Name="QuestionText" Text="{Binding QuestionMessage}" IsVisible="{Binding HasQuestion}"
                 TextWrapping="Wrap" FontWeight="SemiBold" />
      <ListBox x:Name="ChoicesList" IsVisible="{Binding IsSelectQuestion}" MaxHeight="160"
               ItemsSource="{Binding SelectChoices}" SelectedIndex="{Binding SelectedChoice}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="ApplyButton" Content="적용" IsDefault="False" IsVisible="{Binding IsApproveQuestion}" Click="OnYesClick" />
        <Button x:Name="RejectButton" Content="거부" IsVisible="{Binding IsApproveQuestion}" Click="OnNoClick" />
        <Button x:Name="ContinueButton" Content="계속" IsVisible="{Binding IsConfirmQuestion}" Click="OnYesClick" />
        <Button x:Name="StopButton" Content="중단" IsVisible="{Binding IsConfirmQuestion}" Click="OnNoClick" />
        <Button x:Name="SelectButton" Content="선택" IsVisible="{Binding IsSelectQuestion}" IsEnabled="{Binding CanSelect}" Click="OnSelectClick" />
        <Button x:Name="OkButton" Content="확인" IsVisible="{Binding ShowOk}" Click="OnCloseClick" />
      </StackPanel>
    </StackPanel>

    <!-- Progress lines and diff -->
    <Grid RowDefinitions="*,Auto,2*" Margin="0,8,0,0">
      <Border Grid.Row="0" BorderBrush="#D0D0D0" BorderThickness="1">
        <ScrollViewer x:Name="LinesScroll">
          <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" Margin="6,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:StatusLine">
                <SelectableTextBlock Text="{Binding Converter={x:Static v:MainWindowModel.LineText}}"
                                     Foreground="{Binding Converter={x:Static v:MainWindowModel.LineBrush}}"
                                     FontWeight="{Binding Converter={x:Static v:MainWindowModel.LineWeight}}"
                                     TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <TextBlock x:Name="DiffPathText" Grid.Row="1" Text="{Binding DiffPath}" IsVisible="{Binding HasDiff}"
                 FontWeight="SemiBold" Margin="0,8,0,4" />
      <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" IsVisible="{Binding HasDiff}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <ItemsControl x:Name="DiffList" ItemsSource="{Binding DiffLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="v:DiffLineItem">
                <Border Background="{Binding Background}" Padding="6,0">
                  <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                       FontFamily="{StaticResource DiffFont}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
