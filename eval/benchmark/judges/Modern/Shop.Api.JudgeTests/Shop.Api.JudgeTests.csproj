<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <!-- 판정 대상 코퍼스 폴더. 실행기는 작업 복사본(work/<id>/Modern)을 -p:JudgeTargetRoot=... 로 넘긴다. -->
    <JudgeTargetRoot Condition="'$(JudgeTargetRoot)' == ''">$(MSBuildThisFileDirectory)../../../../corpus/Modern</JudgeTargetRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(JudgeTargetRoot)/Shop.Api/Shop.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

</Project>
