<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pelly-eval</AssemblyName>
    <RootNamespace>PellyCoder.Eval</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Field-kit build (M4 Task 9): `dotnet publish -r win-x64` alone yields the single-file pelly-eval.exe, the same way as
       pelly.exe (src/PellyCoder.Cli/PellyCoder.Cli.csproj). No trimming (Roslyn/ScriptDom/SqlClient use reflection). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)'=='win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <!-- DebugType does not reach the referenced Core project, whose PellyCoder.Core.pdb would land beside the exe. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PellyCoder.Core\PellyCoder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
