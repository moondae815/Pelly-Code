<Project Sdk="Microsoft.NET.Sdk">

  <!--
    현장 판정 테스트 프로젝트 템플릿 (field-benchmark.md 「판정 프로젝트」).
    * 스위트의 judges\<루트 이름>\<프로젝트>\ 에 둡니다. 루트 폴더 안에 두지 않습니다.
    * 프로젝트 이름(이 파일 이름)은 테스트 전체 이름의 앞부분이어야 합니다. 예: Modern.JudgeTests.OrderJudgeTests.cs_modern_001_X
    * 실행기는 이 프로젝트를 작업 폴더로 복사하고 -p:JudgeTargetRoot=<작업 복사본의 루트>로 빌드합니다.
      대상 프로젝트는 반드시 $(JudgeTargetRoot) 아래 경로로 참조합니다. 원본 경로를 쓰면 원본을 빌드·시험합니다.
    * 테스트 패키지는 폐쇄망에서 복원할 수 있어야 합니다(사내 NuGet 미러나 로컬 캐시). 깊은 검사(validate의 deep 옵션)가 복원을 확인합니다.
    * {…}를 자기 값으로 바꿉니다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>{대상 프로젝트와 같은 프레임워크, 예: net8.0}</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(JudgeTargetRoot)/{루트 안 대상 프로젝트 경로}/{대상 프로젝트}.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 내장 판정 프로젝트와 같은 xunit.v3.mtp-v2를 권합니다. 폐쇄망에서 복원할 수 있는 버전을 씁니다(사내 NuGet 미러나 로컬 캐시).
         pelly가 테스트별 결과를 읽는 패키지: xunit.v3.mtp-v2, xunit.v3, xunit v2(Microsoft.NET.Test.Sdk + xunit.runner.visualstudio).
         중앙 패키지 관리(Directory.Packages.props)를 쓰면 Version을 뺍니다. -->
    <PackageReference Include="xunit.v3.mtp-v2" Version="{폐쇄망에서 복원할 수 있는 버전, 예: 4.0.2}" />
  </ItemGroup>

</Project>
